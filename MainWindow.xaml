<Window x:Class="GameBottleneckDetector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Bottleneck Detector &amp; Diagnostic v1.1.0" 
        Height="880" Width="1060"
        MinHeight="720" MinWidth="900"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo Moderno e Escuro para as Abas de Navegação -->
        <Style x:Key="NavTabButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="18,9" Margin="0,0,10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="tabBorder" Property="Background" Value="#161B22"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#8B949E"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo Checkbox Quadrado em formato de Card para Configurações e Seletores -->
        <Style x:Key="SquareOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="optBorder" Background="#161B22" BorderBrush="#30363D" BorderThickness="1.5" CornerRadius="6" Padding="12,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Checkbox Quadrado -->
                                <Border x:Name="sqBox" Width="18" Height="18" CornerRadius="3" BorderBrush="#484F58" BorderThickness="1.5" Background="#0D1117" Margin="0,0,10,0">
                                    <TextBlock x:Name="checkGlyph" Text="✓" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="optBorder" Property="Background" Value="#131B26"/>
                                <Setter TargetName="optBorder" Property="BorderBrush" Value="#1F6FEB"/>
                                <Setter TargetName="sqBox" Property="Background" Value="#1F6FEB"/>
                                <Setter TargetName="sqBox" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#8B949E"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="optBorder" Property="BorderBrush" Value="#58A6FF"/>
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Nav Tabs -->
            <RowDefinition Height="*"/>    <!-- Tab Content -->
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tab Buttons com alto contraste escuro -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton x:Name="TabBtnDetector" Content="📊 Detector &amp; Diagnóstico" IsChecked="True" 
                                 Style="{StaticResource NavTabButton}" Checked="TabBtn_Checked"/>
                    <RadioButton x:Name="TabBtnSettings" Content="⚙️ Configurações" 
                                 Style="{StaticResource NavTabButton}" Checked="TabBtn_Checked"/>
                </StackPanel>

                <!-- Hardware info badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtHardwareInfo" Text="Detectando hardware..." FontSize="12" Foreground="#8B949E"/>
                    </Border>
                    <Border x:Name="BadgeAdmin" Background="#238636" CornerRadius="6" Padding="10,6">
                        <TextBlock x:Name="TxtAdminStatus" Text="Admin ✓" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24">
                
                <!-- ================= TAB 1: DETECTOR & SESSÃO ================= -->
                <StackPanel x:Name="TabContentDetector" Visibility="Visible">
                    
                    <!-- Header Text -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Detector de Gargalo &amp; Desempenho" FontSize="22" FontWeight="Bold" Foreground="#F0F6FC"/>
                        <TextBlock Text="Descubra com precisão o que limita seu FPS: Thermal Throttling, CPU single-thread, VRAM ou GPU" 
                                   FontSize="13" Foreground="#8B949E" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Top Row: Equilibrio & Agora -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Equilibrio Teórico -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="EQUILÍBRIO DO HARDWARE" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtCpuShort" Text="CPU" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtGpuShort" Text="GPU" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="BarBalance" Height="6" Value="40" Maximum="100" Background="#21262D" Foreground="#58A6FF" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtBalanceDesc" Text="Carregando relação entre processador e placa de vídeo..." 
                                           FontSize="13" Foreground="#F0F6FC" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- AGORA (Média Móvel 5s) -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0" x:Name="CardAgora">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="AGORA (MÉDIA MÓVEL 5s)" FontSize="11" FontWeight="Bold" Foreground="#8B949E"/>
                                    <Border x:Name="PillStatus" Background="#607D8B" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                        <TextBlock x:Name="TxtPillStatus" Text="Estável" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtLiveTitle" Text="Nada no limite" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtLiveGame" Text="Nenhum jogo em primeiro plano" FontSize="12" Foreground="#8B949E" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtLiveAdvice" Text="Aguardando leituras de sensores..." FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" LineHeight="17"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- LEITURAS AO VIVO: AGRUPADAS POR COMPONENTE (CPU vs GPU vs RAM) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- BLOCO 1: PROCESSADOR (CPU) - Todos os dados de CPU juntos -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PROCESSADOR (CPU)" FontSize="12" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,12"/>

                                <!-- Carga Total CPU -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Carga Total da CPU" FontSize="12" Foreground="#8B949E"/>
                                        <TextBlock x:Name="TxtCpuLoad" Text="0 %" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarCpuLoad" Height="5" Value="0" Maximum="100" Background="#21262D" Foreground="#58A6FF"/>
                                </StackPanel>

                                <!-- Núcleo Mais Ocupado -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="LblCpuCore" Text="Núcleo Mais Ocupado ℹ️" FontSize="12" Foreground="#8B949E"
                                                   ToolTip="Carga do núcleo individual mais estressado. Em jogos, se este núcleo bater 95-100%, o jogo travará mesmo que a CPU total esteja baixa."/>
                                        <TextBlock x:Name="TxtCpuCore" Text="—" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarCpuCore" Height="5" Value="0" Maximum="100" Background="#21262D" Foreground="#E91E63"/>
                                </StackPanel>

                                <!-- Temperatura da CPU -->
                                <StackPanel Margin="0,0,0,4">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="🌡️ Temperatura da CPU" FontSize="12" Foreground="#8B949E"/>
                                        <TextBlock x:Name="TxtCpuTemp" Text="— °C" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarCpuTemp" Height="5" Value="0" Maximum="100" Background="#21262D" Foreground="#F85149"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- BLOCO 2: PLACA DE VÍDEO (GPU) - Todos os dados de GPU juntos -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="PLACA DE VÍDEO (GPU)" FontSize="12" FontWeight="Bold" Foreground="#3FB950" Margin="0,0,0,12"/>

                                <!-- Carga da GPU -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Carga da GPU" FontSize="12" Foreground="#8B949E"/>
                                        <TextBlock x:Name="TxtGpuLoad" Text="0 %" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarGpuLoad" Height="5" Value="0" Maximum="100" Background="#21262D" Foreground="#3FB950"/>
                                </StackPanel>

                                <!-- Temperatura da GPU -->
                                <StackPanel Margin="0,0,0,12">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="🌡️ Temperatura da GPU" FontSize="12" Foreground="#8B949E"/>
                                        <TextBlock x:Name="TxtGpuTemp" Text="— °C" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarGpuTemp" Height="5" Value="0" Maximum="100" Background="#21262D" Foreground="#3FB950"/>
                                </StackPanel>

                                <!-- VRAM da GPU -->
                                <StackPanel Margin="0,0,0,4">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Memória de Vídeo (VRAM)" FontSize="12" Foreground="#8B949E"/>
                                        <TextBlock x:Name="TxtVram" Text="0 %" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar x:Name="BarVram" Height="5" Value="0" Maximum="100" Background="#21262D" Foreground="#D29922"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- BLOCO 3: MEMÓRIA RAM DO SISTEMA -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="MEMÓRIA RAM DO SISTEMA" FontSize="12" FontWeight="Bold" Foreground="#BC8CFF"/>
                                <TextBlock x:Name="TxtRam" Text="0 %" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar x:Name="BarRam" Height="5" Value="0" Maximum="100" Background="#21262D" Foreground="#BC8CFF"/>
                        </StackPanel>
                    </Border>

                    <!-- Painel de Análise de Sessão de Jogo com Checkboxes Quadrados -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ANÁLISE DE SESSÃO DE JOGO" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                                <TextBlock Text="Grave toda a partida ou um trecho específico. O diagnóstico registra segundo a segundo o motivo dos travamentos." 
                                           FontSize="13" Foreground="#F0F6FC" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtSessionStatus" Text="Pronto para iniciar gravação." FontSize="12" Foreground="#8B949E" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Opções de Duração com Checkbox Quadrado Estilizado -->
                                <StackPanel x:Name="PanelDurations" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <RadioButton x:Name="Rb1Min" Content="1 min" IsChecked="True" Style="{StaticResource SquareOption}"/>
                                    <RadioButton x:Name="Rb3Min" Content="3 min" Style="{StaticResource SquareOption}"/>
                                    <RadioButton x:Name="Rb5Min" Content="5 min" Style="{StaticResource SquareOption}"/>
                                    <RadioButton x:Name="Rb10Min" Content="10 min" Style="{StaticResource SquareOption}"/>
                                    <RadioButton x:Name="RbContinuous" Content="Livre / Até Parar" Style="{StaticResource SquareOption}"/>
                                </StackPanel>

                                <!-- Botões de Gravação -->
                                <Button x:Name="BtnSession" Content="INICIAR ANÁLISE" Style="{StaticResource PrimaryButton}" Click="BtnSession_Click"/>
                                <Button x:Name="BtnDiscardSession" Content="DESCARTAR" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnDiscardSession_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Painel de Resultados (aparece ao concluir a análise) -->
                    <Border Style="{StaticResource CardBorder}" x:Name="PanelResults" Visibility="Collapsed" Background="#13171F" BorderBrush="#1F6FEB">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock x:Name="TxtResultTitle" Text="Resultado da Análise" FontSize="18" FontWeight="Bold" Foreground="#58A6FF"/>
                                <Button x:Name="BtnExportHtml" Content="EXPORTAR RELATÓRIO (.HTML) ↗" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Click="BtnExportHtml_Click"/>
                            </Grid>

                            <!-- Alerta Térmico Crítico -->
                            <Border x:Name="BoxThermalAlert" Background="#331A1A" BorderBrush="#DA3633" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                <TextBlock x:Name="TxtThermalAlert" Text="⚠️ ALERTA TÉRMICO CRÍTICO" FontSize="13" FontWeight="Bold" Foreground="#F85149" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Resumo das Métricas -->
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                                <TextBlock x:Name="TxtResultSummary" Text="FPS médio — · 1% low — · CPU máx — · GPU máx — · VRAM máx —" 
                                           FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="DISTRIBUIÇÃO DO TEMPO NA PARTIDA (% GARGALO):" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ListDistribution" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" Foreground="#8B949E"/>
                                            <ProgressBar Grid.Column="1" Height="6" Value="{Binding Pct}" Maximum="100" Background="#21262D" Foreground="{Binding ColorBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PctText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtResultAdvice" Text="Diagnóstico e recomendações..." FontSize="13" Foreground="#F0F6FC" TextWrapping="Wrap" LineHeight="19"/>
                            <TextBlock x:Name="TxtExportStatus" Text="" FontSize="12" Foreground="#3FB950" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= TAB 2: CONFIGURAÇÕES COM CHECKBOX QUADRADO ================= -->
                <StackPanel x:Name="TabContentSettings" Visibility="Collapsed">
                    <TextBlock Text="Configurações &amp; Preferências" FontSize="22" FontWeight="Bold" Foreground="#F0F6FC" Margin="0,0,0,16"/>

                    <!-- Card Formato de Memória -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="FORMATO DE EXIBIÇÃO DE MEMÓRIA (RAM E VRAM)" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,12"/>
                            
                            <!-- RAM Setting -->
                            <TextBlock Text="Exibição de Memória RAM do Sistema:" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,16">
                                <RadioButton x:Name="RbRamGb" Content="Valores Reais em Gigabytes (ex: 7.8 GB / 16.0 GB - 48%)" Style="{StaticResource SquareOption}" Checked="SettingChanged"/>
                                <RadioButton x:Name="RbRamPct" Content="Apenas Percentual (ex: 48%)" Style="{StaticResource SquareOption}" Checked="SettingChanged"/>
                                <RadioButton x:Name="RbRamMb" Content="Megabytes (ex: 7980 MB / 16384 MB)" Style="{StaticResource SquareOption}" Checked="SettingChanged"/>
                            </StackPanel>

                            <!-- VRAM Setting -->
                            <TextBlock Text="Exibição de Memória de Vídeo (VRAM da GPU):" FontSize="13" FontWeight="SemiBold" Foreground="#F0F6FC" Margin="0,0,0,8"/>
                            <StackPanel Margin="0,0,0,10">
                                <RadioButton x:Name="RbVramGb" Content="Valores Reais em Gigabytes (ex: 3.4 GB / 4.0 GB - 85%)" Style="{StaticResource SquareOption}" Checked="SettingChanged"/>
                                <RadioButton x:Name="RbVramPct" Content="Apenas Percentual (ex: 85%)" Style="{StaticResource SquareOption}" Checked="SettingChanged"/>
                                <RadioButton x:Name="RbVramMb" Content="Megabytes (ex: 3480 MB / 4096 MB)" Style="{StaticResource SquareOption}" Checked="SettingChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card Guia de Conceitos -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="GUIA DE CONCEITOS E DIAGNÓSTICO" FontSize="11" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="Por que o 'Núcleo Mais Ocupado' é crucial em jogos?" FontSize="14" FontWeight="Bold" Foreground="#58A6FF" Margin="0,4,0,4"/>
                            <TextBlock Text="A maioria dos jogos possui uma thread principal de lógica e renderização que roda em apenas 1 núcleo da CPU. Se esse núcleo estiver em 95–100%, o jogo travará mesmo que o 'Uso Total da CPU' esteja em apenas 40% ou 50%. Ficar atento a este indicador revela se o processador está limitando o FPS sem você perceber." 
                                       FontSize="13" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="O que é o Thermal Throttling da CPU?" FontSize="14" FontWeight="Bold" Foreground="#F85149" Margin="0,4,0,4"/>
                            <TextBlock Text="Em notebooks gamers como o Acer Aspire VX5 (i7-7700HQ), quando a temperatura da CPU atinge 95°C a 100°C, o hardware reduz drasticamente a velocidade de clock (de ~3.4 GHz para 800 MHz) para evitar danos físicos por superaquecimento. Essa queda brusca gera travadas severas (stuttering) e microcongelamentos durante o jogo." 
                                       FontSize="13" Foreground="#8B949E" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="Como funciona a gravação 'Livre / Até Parar'?" FontSize="14" FontWeight="Bold" Foreground="#3FB950" Margin="0,4,0,4"/>
                            <TextBlock Text="No modo livre, você pode jogar uma partida inteira (30 minutos, 1 hora ou mais). A coleta é extremamente leve (~0,05% de CPU e ~300 KB de RAM por hora). Quando terminar de jogar, clique em 'Concluir Análise' para compilar todo o histórico da partida e abrir o relatório HTML." 
                                       FontSize="13" Foreground="#8B949E" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Info sobre configurações salvas -->
                    <TextBlock x:Name="TxtSettingsSaved" Text="✓ As preferências são salvas automaticamente em settings.json" FontSize="12" Foreground="#3FB950"/>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
